" vim-lists: the lists roumail's plugins show in a window at the bottom, all
" opened, filtered, redrawn and closed the same way (roumail_lists#open)
if exists('g:loaded_roumail_lists')
  finish
endif
let g:loaded_roumail_lists = 1

" g:roumail_lists_height: the most lines a list's window takes (default 15)
